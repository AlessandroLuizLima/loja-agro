# Copie para .env.local (desenvolvimento) ou configure no servidor (produção).

# Segredo para assinar o cookie de sessão (mínimo 32 caracteres). Um diferente por loja.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Primeiro acesso ao painel (/admin). Só é usado se a loja ainda não tiver administrador;
# depois a senha é trocada pelo próprio painel.
ADMIN_EMAIL=admin@loja.test
ADMIN_PASSWORD=troque-esta-senha-123

# Arquivo do banco SQLite (produtos, pedidos, clientes, fotos e configurações)
DATABASE_PATH=./data/loja.db

# Endereço público (opcional: também dá para definir em Painel > Configurações > Domínio)
SITE_URL=http://localhost:3000

# "false" para começar com a loja vazia, sem os produtos de demonstração
SEED_DEMO=true
