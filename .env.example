# Copie para .env.local (desenvolvimento) ou configure no servidor (produção).

# Segredo para assinar o cookie de sessão (mínimo 32 caracteres). Um diferente por loja.
# Também protege a chave da verificação em duas etapas: se trocar depois, todos saem da conta
# e quem usa verificação em duas etapas precisa de ADMIN_DISABLE_2FA para ativar de novo.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Primeiro acesso ao painel. Só é usado se a loja ainda não tiver administrador;
# no primeiro login o painel obriga a criar uma senha nova.
ADMIN_EMAIL=admin@loja.test
ADMIN_PASSWORD=troque-esta-senha-123

# Endereço secreto do painel (opcional). Ex.: gestao-7k2mq9 -> https://sualoja.com.br/gestao-7k2mq9
# De 6 a 64 letras minúsculas, números e hífen. Com ele, /admin responde "página não encontrada".
# Em branco: o painel fica em /admin.
ADMIN_PATH=

# Emergência: o lojista perdeu o celular e os códigos de recuperação.
# Coloque o e-mail dele aqui, reinicie a loja (a verificação em duas etapas dessa conta é desligada) e apague a linha.
ADMIN_DISABLE_2FA=

# Envio dos códigos de confirmação de e-mail e celular do cliente (opcional).
# Sem eles, no seu computador o código aparece na tela (modo de teste) e em produção a opção some.
# E-mail com Resend (resend.com, grátis até 3.000 e-mails/mês); EMAIL_FROM precisa ser de um domínio verificado lá.
RESEND_API_KEY=
EMAIL_FROM="Agro Boa Terra <nao-responda@sualoja.com.br>"
# SMS com Twilio (twilio.com, cobrado por mensagem)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Arquivo do banco SQLite (produtos, pedidos, clientes, fotos e configurações)
DATABASE_PATH=./data/loja.db

# Endereço público (opcional: também dá para definir em Painel > Configurações > Domínio)
SITE_URL=http://localhost:3000

# "false" para começar com a loja vazia, sem os produtos de demonstração
SEED_DEMO=true
