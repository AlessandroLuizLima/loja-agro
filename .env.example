# Segredo para assinar o cookie de sessão (mínimo 32 caracteres).
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# URL pública da loja (usada no sitemap, robots e metadados)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Caminho do banco SQLite (padrão: ./data/pethouse.db)
DATABASE_PATH=./data/pethouse.db
