# Copie para .env (no servidor) e preencha. Nunca envie o .env para o GitHub.
# Gere cada segredo com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ou: openssl rand -base64 32

# Loja A
LOJA_A_DOMINIO=agropecuariaexemplo.com.br
LOJA_A_SESSION_SECRET=
LOJA_A_ADMIN_EMAIL=dono@agropecuariaexemplo.com.br
LOJA_A_ADMIN_PASSWORD=
# Endereço secreto do painel: https://DOMINIO/<ADMIN_PATH>. Gere com: openssl rand -hex 4  (ex.: gestao-3f9a1c7e)
LOJA_A_ADMIN_PATH=
# Códigos de confirmação de e-mail/celular dos clientes (opcional; ver .env.example na raiz)
LOJA_A_RESEND_API_KEY=
LOJA_A_EMAIL_FROM=
LOJA_A_TWILIO_ACCOUNT_SID=
LOJA_A_TWILIO_AUTH_TOKEN=
LOJA_A_TWILIO_FROM=

# Loja B
LOJA_B_DOMINIO=outraagro.com.br
LOJA_B_SESSION_SECRET=
LOJA_B_ADMIN_EMAIL=dono@outraagro.com.br
LOJA_B_ADMIN_PASSWORD=
LOJA_B_ADMIN_PATH=
LOJA_B_RESEND_API_KEY=
LOJA_B_EMAIL_FROM=
LOJA_B_TWILIO_ACCOUNT_SID=
LOJA_B_TWILIO_AUTH_TOKEN=
LOJA_B_TWILIO_FROM=
